# API Keys (comma-separated). Leave empty to disable auth (dev mode).
# Example: API_KEYS=key1,key2
API_KEYS=

# Cache directory
CACHE_DIR=/tmp/ws_api_cache

# Cache TTL in seconds
CACHE_TTL=300

# Rate limiting (requests per minute per API key)
RATE_LIMIT=60

# HTTP client timeouts
HTTP_TIMEOUT=10.0
